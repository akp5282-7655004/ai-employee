{
  "name": "ai-employee",
  "version": "0.0.1",
  "private": true,
  "description": "A horizontal AI marketing employee sold through vertical doors — a shared engine plus category-specific command packs. Working name; see docs/VISION.md.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "demo": "tsx scripts/demo.ts",
    "demo:connect": "tsx scripts/demo-connect.ts",
    "demo:agent": "tsx scripts/demo-agent.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@higgsfield/client": "^0.2.1",
    "@pipedream/sdk": "^3.1.2",
    "fastify": "^5.1.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
