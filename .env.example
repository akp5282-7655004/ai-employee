# Everything defaults to offline/mock — copy to .env only when going live.

# Server
PORT=3000
HOST=0.0.0.0

# Language understanding: set a key to use Claude instead of the regex mock.
# Also run:  npm install @anthropic-ai/sdk
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001


# Connector: "mock" (default, offline) or "pipedream" (live).
CONNECTOR=mock

# Pipedream Connect (from `pd init connect`, or the Pipedream dashboard →
# project → Connect → API credentials). Required only when CONNECTOR=pipedream.
PIPEDREAM_ENVIRONMENT=development   # or "production"
PIPEDREAM_PROJECT_ID=
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=

# Going live also needs the SDK installed:  npm install @pipedream/sdk

# Stripe. Leave blank and the app keeps working. Plan buttons say "Stripe not connected".
# The charged amount is the Price you create in Stripe. These names are the ones the app reads.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
# Public URL of this app. Checkout, the customer portal, and the webhook all use it.
APP_URL=
# Email of the Miles owner. Only this account sees /admin.
ADMIN_EMAIL=

# Chat with Miles. OpenRouter tool calling. Leave blank and chat answers from the account snapshot.
# MILES_AGENT_MODEL is the cheap model used for owner chat. MILES_AGENT_MODEL_STRONG is reserved for later builds and is not called yet.
OPENROUTER_API_KEY=
MILES_AGENT_MODEL=openai/gpt-4o-mini
MILES_AGENT_MODEL_STRONG=anthropic/claude-sonnet-4.5
