# Everything defaults to offline/mock — copy to .env only when going live.

# Server
PORT=3000
HOST=0.0.0.0

# Language understanding: set a key to use Claude instead of the regex mock.
# Also run:  npm install @anthropic-ai/sdk
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001


# Connector: "mock" (default, offline) or "pipedream" (live).
CONNECTOR=mock

# Pipedream Connect (from `pd init connect`, or the Pipedream dashboard →
# project → Connect → API credentials). Required only when CONNECTOR=pipedream.
PIPEDREAM_ENVIRONMENT=development   # or "production"
PIPEDREAM_PROJECT_ID=
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=

# Going live also needs the SDK installed:  npm install @pipedream/sdk
